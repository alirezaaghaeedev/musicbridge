APP_NAME=MusicBridge
APP_ENV=development
APP_MODE=mock
PUBLIC_BASE_URL=http://127.0.0.1:8787
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=GENERATE_WITH_NPM_RUN_SECRETS_GENERATE
TOKEN_ENCRYPTION_KEY=GENERATE_WITH_NPM_RUN_SECRETS_GENERATE
BOT_ACCESS_MODE=private
ALLOWED_TELEGRAM_USER_IDS=123
DEFAULT_LOCALE=fa
DEFAULT_AUTO_ADD_ENABLED=false
DEFAULT_MATCH_THRESHOLD=80
DEFAULT_MINIMUM_ARTIST_SCORE=75
